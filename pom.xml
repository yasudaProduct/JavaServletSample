<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>servlet-sample</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>Java Servlet Sample</name>
  <description>JSP / Servlet / Bootstrap 4 で作る Web システムのサンプル集</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Tomcat 9 系 (Servlet 4.0 / JSP 2.3 / javax.* 名前空間) を対象にしています。 -->
    <servlet-api.version>4.0.1</servlet-api.version>
    <jsp-api.version>2.3.3</jsp-api.version>
    <jstl.version>1.2</jstl.version>
    <h2.version>2.2.224</h2.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!--
      共通ライブラリ (shared/pom.xml)。別プロジェクトとして先にビルドし、
      ローカルリポジトリへ install してから参照します。

        mvn -f shared/pom.xml install
        mvn package

      版は固定で書きます (-SNAPSHOT にしない)。複数サーバー構成では
      「どのサーバーがどの版で動いているか」を後から追えることが最優先です。
      WAR の WEB-INF/lib に同梱されるので、WAR を戻せば共通処理の版も戻ります。
    -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>servlet-sample-shared</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- Servlet API : Tomcat が提供するため provided -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>${servlet-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JSP API : Tomcat が提供するため provided -->
    <dependency>
      <groupId>javax.servlet.jsp</groupId>
      <artifactId>javax.servlet.jsp-api</artifactId>
      <version>${jsp-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JSTL : Tomcat には含まれないので WAR に同梱する -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>jstl</artifactId>
      <version>${jstl.version}</version>
    </dependency>

    <!--
      H2 Database : ファイルや一覧のサンプルで使う組み込みデータベース。
      別途 DB サーバを立てなくても動くよう、メモリ上で動かしています
      (WAR に同梱するため provided ではなく既定の compile スコープ)。
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>

    <!-- テスト -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Tomcat の ROOT コンテキスト (http://localhost:8080/) で動かすため ROOT 固定 -->
    <finalName>ROOT</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <failOnMissingWebXml>true</failOnMissingWebXml>
          <webResources>
            <!--
              サンプル集では「動いている画面」と「そのソースコード」を並べて見せたいので、
              Java のソースファイルそのものを WAR に含めて実行時に読めるようにしています。
              (WEB-INF 配下なのでブラウザから直接ダウンロードはされません)
            -->
            <resource>
              <directory>src/main/java</directory>
              <targetPath>WEB-INF/sources/java</targetPath>
              <includes>
                <include>**/*.java</include>
              </includes>
            </resource>
            <!-- 共通ライブラリのソースは別プロジェクトなので別の場所に置く -->
            <resource>
              <directory>shared/src/main/java</directory>
              <targetPath>WEB-INF/sources/shared</targetPath>
              <includes>
                <include>**/*.java</include>
              </includes>
            </resource>
            <!--
              ビルド設定そのもの。「共通処理を JAR に切り出す」サンプルで、
              Eclipse / Ant / Maven の 3 つが同じことをどう書いているかを画面に並べます。
              (build.xml の explode ターゲット ⑤ と同じ内容)
            -->
            <resource>
              <directory>${project.basedir}</directory>
              <targetPath>WEB-INF/sources/build</targetPath>
              <includes>
                <include>pom.xml</include>
                <include>build.xml</include>
                <include>.classpath</include>
              </includes>
            </resource>
            <resource>
              <directory>${project.basedir}/.settings</directory>
              <targetPath>WEB-INF/sources/build</targetPath>
              <includes>
                <include>org.eclipse.wst.common.component</include>
              </includes>
            </resource>
            <resource>
              <directory>${project.basedir}/shared</directory>
              <targetPath>WEB-INF/sources/build/shared</targetPath>
              <includes>
                <include>pom.xml</include>
              </includes>
            </resource>
          </webResources>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
