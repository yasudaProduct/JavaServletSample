<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Java Servlet サンプル集</display-name>

  <!-- ===================================================================
       サイト共通の設定値
       JSP からは ${initParam.siteTitle} のように参照できます。
       =================================================================== -->
  <context-param>
    <param-name>siteTitle</param-name>
    <param-value>Java Servlet サンプル集</param-value>
  </context-param>
  <context-param>
    <param-name>siteDescription</param-name>
    <param-value>JSP / Servlet / Bootstrap 4 で作る Web システムのサンプル集</param-value>
  </context-param>
  <context-param>
    <param-name>githubUrl</param-name>
    <param-value>https://github.com/yasudaProduct/JavaServletSample</param-value>
  </context-param>

  <!-- ===================================================================
       文字コード (Servlet 4.0 の機能。フィルタを書かなくても UTF-8 になる)
       =================================================================== -->
  <request-character-encoding>UTF-8</request-character-encoding>
  <response-character-encoding>UTF-8</response-character-encoding>

  <!-- ===================================================================
       JSP 共通設定
       =================================================================== -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <!-- ディレクティブの改行が HTML に出力されないようにする -->
      <trim-directive-whitespaces>true</trim-directive-whitespaces>
      <!--
        画面を組み立てる途中でエラーが起きたときに、書きかけの HTML を捨てて
        エラーページ (error/500.jsp) に差し替えられるようにするためのバッファです。
        既定の 8kb だと画面の途中で送信が始まってしまうため、書きかけの HTML の後ろに
        エラーページが継ぎ足される形になり、「画面が真っ白」に見えてしまいます。
      -->
      <buffer>64kb</buffer>
      <!-- 古い書き方 (スクリプトレット) を使わない方針であれば true にする -->
      <scripting-invalid>false</scripting-invalid>
    </jsp-property-group>
  </jsp-config>

  <!-- ===================================================================
       セッション
       =================================================================== -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- ===================================================================
       フィルタ (サンプル : 応用・その他 > フィルタで共通処理をはさむ)

       フィルタは @WebFilter アノテーションでも登録できますが、
       複数あるときの「適用される順番」を指定できません。
       順番が意味を持つ場合は、このように web.xml へ書きます。

       適用順は <filter-mapping> を書いた順です (<filter> の順ではありません)。
         1. requestIdFilter   … リクエスト ID を採番する
         2. accessLogFilter   … 処理時間を測ってログに出す
         3. accessCheckFilter … 通してよいか判断する (駄目ならここで折り返す)

       このサンプルでは分かりやすさのため /samples/advanced/filter 配下だけに掛けています。
       サイト全体に掛けるなら <url-pattern>/*</url-pattern> です。
       =================================================================== -->
  <filter>
    <filter-name>requestIdFilter</filter-name>
    <filter-class>com.example.servletsample.samples.advanced.RequestIdFilter</filter-class>
  </filter>
  <filter>
    <filter-name>accessLogFilter</filter-name>
    <filter-class>com.example.servletsample.samples.advanced.AccessLogFilter</filter-class>
    <!-- init-param は起動時に 1 回だけ読まれます (init メソッドで受け取る) -->
    <init-param>
      <param-name>slowMillis</param-name>
      <param-value>1000</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>accessCheckFilter</filter-name>
    <filter-class>com.example.servletsample.samples.advanced.AccessCheckFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>requestIdFilter</filter-name>
    <url-pattern>/samples/advanced/filter</url-pattern>
    <url-pattern>/samples/advanced/filter/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>accessLogFilter</filter-name>
    <url-pattern>/samples/advanced/filter</url-pattern>
    <url-pattern>/samples/advanced/filter/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>accessCheckFilter</filter-name>
    <url-pattern>/samples/advanced/filter</url-pattern>
    <url-pattern>/samples/advanced/filter/*</url-pattern>
    <!--
      <dispatcher> を書かないと REQUEST だけ (ブラウザから直接届いたとき) が対象です。
      Servlet から JSP への forward では動きません。
    -->
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

  <!-- ===================================================================
       エラーページ

       受け止められなかった例外と response.sendError(...) は、
       コンテナがここの設定を見て、対応する JSP へ「転送」します。
       (リダイレクトではないので、ブラウザの URL は元のままです)

       選ばれ方は次のとおりです。
         1. 例外が起きた場合 … <exception-type> のうち、継承関係でもっとも近いもの
         2. 1 が無い場合     … <error-code> がステータスコードに一致するもの
         3. どちらも無い場合 … コンテナ既定のエラー画面 (スタックトレースが出ることがある)

       エラーページの JSP も /WEB-INF/ の下に置いています。
       ブラウザから直接開かれると、エラーでもないのにエラー画面が出てしまうためです。

       解説は「応用・その他 > エラー処理とエラーページ」のサンプルにあります。
       =================================================================== -->
  <error-page>
    <error-code>400</error-code>
    <location>/WEB-INF/views/error/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/error/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error/404.jsp</location>
  </error-page>
  <error-page>
    <error-code>405</error-code>
    <location>/WEB-INF/views/error/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error/500.jsp</location>
  </error-page>

  <!--
    業務例外 (在庫不足・締め切り超過など) だけは専用の画面に割り当てます。
    ApplicationException は RuntimeException を継承していますが、
    コンテナは「もっとも近い型」を選ぶため、下の Throwable より優先されます。
  -->
  <error-page>
    <exception-type>com.example.servletsample.samples.advanced.ApplicationException</exception-type>
    <location>/WEB-INF/views/error/application-error.jsp</location>
  </error-page>

  <!-- 上のどれにも当てはまらない例外はすべてここへ (最後の受け皿) -->
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/error/500.jsp</location>
  </error-page>

  <!-- ===================================================================
       静的ファイルの MIME タイプ
       =================================================================== -->
  <mime-mapping>
    <extension>svg</extension>
    <mime-type>image/svg+xml</mime-type>
  </mime-mapping>

</web-app>
