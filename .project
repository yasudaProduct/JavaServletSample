<?xml version="1.0" encoding="UTF-8"?>
<!--
  Eclipse のプロジェクト定義。
  「ファイル → インポート → 一般 → 既存プロジェクトをワークスペースへ」で
  このフォルダを指定すると、動的 Web プロジェクトとして開きます。

  natures が「このプロジェクトは何か」を、buildSpec が「何でビルドするか」を表します。
  ModuleCoreNature が入っていることで、デプロイメント・アセンブリー
  (.settings/org.eclipse.wst.common.component) が効くようになります。
-->
<projectDescription>
	<name>JavaServletSample</name>
	<comment>JSP / Servlet / Bootstrap 4 で作る Web システムのサンプル集</comment>
	<projects>
	</projects>
	<buildSpec>
		<buildCommand>
			<name>org.eclipse.jdt.core.javabuilder</name>
			<arguments>
			</arguments>
		</buildCommand>
		<buildCommand>
			<name>org.eclipse.wst.common.project.facet.core.builder</name>
			<arguments>
			</arguments>
		</buildCommand>
		<buildCommand>
			<name>org.eclipse.wst.validation.validationbuilder</name>
			<arguments>
			</arguments>
		</buildCommand>
	</buildSpec>
	<natures>
		<nature>org.eclipse.jem.workbench.JavaEMFNature</nature>
		<nature>org.eclipse.wst.common.modulecore.ModuleCoreNature</nature>
		<nature>org.eclipse.jdt.core.javanature</nature>
		<nature>org.eclipse.wst.common.project.facet.core.nature</nature>
	</natures>
</projectDescription>
