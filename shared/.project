<?xml version="1.0" encoding="UTF-8"?>
<!--
  Eclipse のプロジェクト定義 (共通ライブラリ側)。

  Web プロジェクト側と違い jst.web ではなく jst.utility ファセットを使います。
  これが「WAR に JAR として同梱されるプロジェクト」という意味になり、
  Web プロジェクトのデプロイメント・アセンブリーから参照できるようになります。
-->
<projectDescription>
	<name>servlet-sample-shared</name>
	<comment>複数のアプリから使う共通処理（状態を持たないものだけ）</comment>
	<projects>
	</projects>
	<buildSpec>
		<buildCommand>
			<name>org.eclipse.jdt.core.javabuilder</name>
			<arguments>
			</arguments>
		</buildCommand>
		<buildCommand>
			<name>org.eclipse.wst.common.project.facet.core.builder</name>
			<arguments>
			</arguments>
		</buildCommand>
		<buildCommand>
			<name>org.eclipse.wst.validation.validationbuilder</name>
			<arguments>
			</arguments>
		</buildCommand>
	</buildSpec>
	<natures>
		<nature>org.eclipse.jem.workbench.JavaEMFNature</nature>
		<nature>org.eclipse.wst.common.modulecore.ModuleCoreNature</nature>
		<nature>org.eclipse.jdt.core.javanature</nature>
		<nature>org.eclipse.wst.common.project.facet.core.nature</nature>
	</natures>
</projectDescription>
