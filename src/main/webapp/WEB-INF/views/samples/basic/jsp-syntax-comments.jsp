<%-- 【サンプル】JSP の記法 : コメントがブラウザまで届くかどうかを見るための部品 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- ① JSP のコメント。ブラウザには届きません (翻訳の時点で消えます) --%>
<!-- ② HTML のコメント。ブラウザまで届きます (ページのソースに出ます) -->
<p>本文です。</p>
<%-- ③ JSP コメントの中の EL は実行されません : ${1 + 1} --%>
<!-- ④ HTML コメントの中の EL は実行されます : ${1 + 1} -->
<%
    // ⑤ Java のコメント。生成された Java のソースにだけ残ります
    /* こちらも同じです */
%>
